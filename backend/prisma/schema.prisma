generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum CallStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(TECHNICIAN)

  callsAssigned Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sector {
  id   String @id @default(uuid())
  name String @unique

  calls Call[]

  createdAt DateTime @default(now())
}

model Call {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      CallStatus @default(OPEN)

  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id])

  report Report?

  openedAt   DateTime  @default(now())
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id String @id @default(uuid())

  technicianName String

  serviceDone String

  partChanged Boolean @default(false)

  partName String?

  observations String?

  startTime DateTime
  endTime   DateTime

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id])

  createdAt DateTime @default(now())
}
