generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum ServiceType {
  CORRECTIVE
  PREVENTIVE
  PREDICTIVE
  INSTALLATION
}

enum TechnicianLevel {
  JUNIOR
  MID
  SENIOR
  SPECIALIST
}

enum RequesterCallStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum CallStatus {
  PLANNING
  OPEN
  READY
  IN_PROGRESS
  HELP_REQUESTED
  WAITING_PARTS
  WAITING_APPROVAL
  COMPLETED
  REJECTED
  CANCELLED
}

enum CallPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CallHistoryAction {
  CREATED
  ASSIGNED
  TRANSFERRED
  STARTED
  PAUSED
  RESUMED
  WAITING_PARTS
  HELP_REQUESTED
  HELP_APPROVED
  HELP_REJECTED
  ASSISTANT_ADDED
  ASSISTANT_REMOVED
  COMMENT_ADDED
  ATTACHMENT_ADDED
  COMPLETED
  REOPENED
  PRIORITY_CHANGED
  LEVEL_CHANGED
  CATEGORY_CHANGED
  LOCATION_CHANGED
  STATUS_CHANGED
  PLANNING_STARTED
  PLANNING_UPDATED
  PLANNING_CONFIRMED
  PLANNING_CANCELLED
  TEAM_CONFIRMED
  READY_FOR_EXECUTION
}

enum HelpRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttachmentType {
  BEFORE
  AFTER
  OTHER
}

enum NotificationType {
  NEW_CALL
  CALL_ASSIGNED
  CALL_TRANSFERRED
  HELP_REQUEST
  HELP_APPROVED
  HELP_REJECTED
  WAITING_PARTS
  COMMENT
  CALL_COMPLETED
  CALL_REOPENED
  PRIORITY_CHANGED
  SYSTEM
}

enum ProtocolType {
  CALL
  REQUESTER_CALL
}

enum PlanningStatus {
  DRAFT
  READY_TO_CONFIRM
  CONFIRMED
  CANCELLED
}

enum PlanningMemberRole {
  RESPONSIBLE
  ASSISTANT
}

enum PlanningRequirementType {
  PART
  TOOL
  PPE
  PERMIT
  SHUTDOWN
  OTHER
}

enum PlanningRequirementStatus {
  PENDING
  AVAILABLE
  UNAVAILABLE
  WAIVED
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  password     String
  role         UserRole        @default(TECHNICIAN)
  isTechnician Boolean         @default(true)
  level        TechnicianLevel @default(JUNIOR)

  assignedCalls        Call[]           @relation("AssignedTechnician")
  openedCalls          Call[]           @relation("OpenedBy")
  workLogs             WorkLog[]
  hourBatches          HourBatch[]
  history              CallHistory[]
  assistantCalls       CallAssistant[]  @relation("AssistantTechnician")
  addedAssistants      CallAssistant[]  @relation("AssistantAddedBy")
  helpRequestsCreated  HelpRequest[]    @relation("HelpRequestedBy")
  helpRequestsReceived HelpRequest[]    @relation("HelpRequestedTechnician")
  callAttachments      CallAttachment[]
  reports              Report[]
  notifications        Notification[]
  userAreas            UserArea[]

  commissionSettlements CommissionSettlement[] @relation("SettlementTechnician")
  createdSettlements    CommissionSettlement[] @relation("SettlementCreatedBy")

  createdCallPlannings   CallPlanning[]       @relation("PlanningCreatedBy")
  confirmedCallPlannings CallPlanning[]       @relation("PlanningConfirmedBy")
  planningMemberships    CallPlanningMember[] @relation("PlanningMemberTechnician")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([level])
}

model Location {
  id             String          @id @default(uuid())
  name           String
  normalizedName String
  locationCode   String          @unique
  parentId       String?
  parent         Location?       @relation("LocationTree", fields: [parentId], references: [id])
  children       Location[]      @relation("LocationTree")
  calls          Call[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  requesterCalls RequesterCall[]

  @@index([parentId])
  @@index([normalizedName])
}

model Requester {
  id             String          @id @default(uuid())
  name           String
  phone          String?
  calls          Call[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  requesterCalls RequesterCall[]
}

model RequesterCall {
  id          String              @id @default(uuid())
  protocol    String              @unique
  title       String
  description String
  status      RequesterCallStatus @default(PENDING)

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  requesterId String
  requester   Requester @relation(fields: [requesterId], references: [id])

  call Call?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([requesterId])
  @@index([locationId])
}

model Call {
  id       String @id @default(uuid())
  protocol String @unique

  requesterCallId String?        @unique
  requesterCall   RequesterCall? @relation(fields: [requesterCallId], references: [id])

  title         String
  description   String?
  requiredLevel TechnicianLevel?
  status        CallStatus       @default(OPEN)
  priority      CallPriority     @default(MEDIUM)
  serviceType   ServiceType

  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  requesterId String?
  requester   Requester? @relation(fields: [requesterId], references: [id])

  openedById String
  openedBy   User   @relation("OpenedBy", fields: [openedById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTechnician", fields: [assignedToId], references: [id])

  planning CallPlanning?

  report        Report?
  workLogs      WorkLog[]
  history       CallHistory[]
  assistants    CallAssistant[]
  helpRequests  HelpRequest[]
  attachments   CallAttachment[]
  notifications Notification[]
  callAreas     CallArea[]

  commissionSettlementCall CommissionSettlementCall?

  openedAt   DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([assignedToId, status])
  @@index([status, createdAt])
  @@index([locationId, createdAt])
  @@index([openedById, createdAt])
  @@index([requesterId, createdAt])
  @@index([priority, status])
  @@index([requiredLevel, status])
}

model CallPlanning {
  id String @id @default(uuid())

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)

  status PlanningStatus @default(DRAFT)

  plannedStartAt DateTime?
  plannedEndAt   DateTime?

  instructions String?
  observations String?

  requiresShutdown Boolean @default(false)
  requiresPermit   Boolean @default(false)
  requiresParts    Boolean @default(false)
  requiresTools    Boolean @default(false)

  createdById String
  createdBy   User   @relation("PlanningCreatedBy", fields: [createdById], references: [id])

  confirmedById String?
  confirmedBy   User?   @relation("PlanningConfirmedBy", fields: [confirmedById], references: [id])

  confirmedAt DateTime?

  teamMembers  CallPlanningMember[]
  requirements CallPlanningRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plannedStartAt])
  @@index([createdById])
  @@index([confirmedById])
}

model CallPlanningMember {
  id String @id @default(uuid())

  planningId String
  planning   CallPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  technicianId String
  technician   User   @relation("PlanningMemberTechnician", fields: [technicianId], references: [id])

  role PlanningMemberRole

  createdAt DateTime @default(now())

  @@unique([planningId, technicianId])
  @@index([planningId])
  @@index([technicianId])
  @@index([role])
}

model CallPlanningRequirement {
  id String @id @default(uuid())

  planningId String
  planning   CallPlanning @relation(fields: [planningId], references: [id], onDelete: Cascade)

  type        PlanningRequirementType
  status      PlanningRequirementStatus @default(PENDING)
  description String
  quantity    Decimal?
  unit        String?
  observation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planningId])
  @@index([type, status])
}

model ProtocolCounter {
  id    String       @id
  type  ProtocolType
  year  Int
  value Int

  @@unique([type, year])
}

model Area {
  id             String     @id @default(uuid())
  name           String     @unique
  normalizedName String
  users          UserArea[]
  callAreas      CallArea[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([normalizedName])
}

model CallArea {
  id     String @id @default(uuid())
  callId String
  call   Call   @relation(fields: [callId], references: [id], onDelete: Cascade)
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([callId, areaId])
  @@index([callId])
  @@index([areaId])
}

model UserArea {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId String
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@unique([userId, areaId])
  @@index([userId])
  @@index([areaId])
}

model CallAssistant {
  id           String   @id @default(uuid())
  callId       String
  call         Call     @relation(fields: [callId], references: [id])
  technicianId String
  technician   User     @relation("AssistantTechnician", fields: [technicianId], references: [id])
  addedById    String
  addedBy      User     @relation("AssistantAddedBy", fields: [addedById], references: [id])
  createdAt    DateTime @default(now())

  @@unique([callId, technicianId])
  @@index([callId])
  @@index([technicianId])
}

model HelpRequest {
  id            String            @id @default(uuid())
  callId        String
  call          Call              @relation(fields: [callId], references: [id])
  requestedById String
  requestedBy   User              @relation("HelpRequestedBy", fields: [requestedById], references: [id])
  technicianId  String
  technician    User              @relation("HelpRequestedTechnician", fields: [technicianId], references: [id])
  status        HelpRequestStatus @default(PENDING)
  message       String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([callId])
  @@index([requestedById])
  @@index([technicianId])
  @@index([status])
}

model CallAttachment {
  id           String         @id @default(uuid())
  callId       String
  call         Call           @relation(fields: [callId], references: [id])
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  fileName     String
  fileUrl      String
  type         AttachmentType
  createdAt    DateTime       @default(now())

  @@index([callId])
  @@index([uploadedById])
  @@index([type])
}

model Report {
  id           String   @id @default(uuid())
  callId       String   @unique
  call         Call     @relation(fields: [callId], references: [id])
  serviceDone  String
  partChanged  Boolean  @default(false)
  partName     String?
  observations String?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdById])
}

model WorkLog {
  id           String     @id @default(uuid())
  callId       String
  call         Call       @relation(fields: [callId], references: [id])
  technicianId String
  technician   User       @relation(fields: [technicianId], references: [id])
  startTime    DateTime
  endTime      DateTime?
  batchId      String?
  batch        HourBatch? @relation(fields: [batchId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([callId])
  @@index([technicianId])
  @@index([batchId])
}

model HourBatch {
  id           String    @id @default(uuid())
  technicianId String
  technician   User      @relation(fields: [technicianId], references: [id])
  workLogs     WorkLog[]
  pdfPath      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([technicianId])
}

model CallHistory {
  id          String            @id @default(uuid())
  action      CallHistoryAction
  observation String?
  metadata    Json?
  callId      String
  call        Call              @relation(fields: [callId], references: [id])
  userId      String
  user        User              @relation(fields: [userId], references: [id])
  createdAt   DateTime          @default(now())

  @@index([callId])
  @@index([userId])
  @@index([action])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  callId    String?
  call      Call?            @relation(fields: [callId], references: [id])
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([callId])
  @@index([read])
  @@index([type])
}

model CommissionSettlement {
  id String @id @default(uuid())

  technicianId String
  technician   User   @relation("SettlementTechnician", fields: [technicianId], references: [id])

  createdById String
  createdBy   User   @relation("SettlementCreatedBy", fields: [createdById], references: [id])

  totalCalls  Int
  observation String?

  calls CommissionSettlementCall[]

  createdAt DateTime @default(now())

  @@index([technicianId])
  @@index([createdById])
  @@index([createdAt])
}

model CommissionSettlementCall {
  id String @id @default(uuid())

  settlementId String
  settlement   CommissionSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  callId       String               @unique
  call         Call                 @relation(fields: [callId], references: [id])

  createdAt DateTime @default(now())

  @@index([settlementId])
}
