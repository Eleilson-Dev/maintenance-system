generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum CallStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum CallPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CallHistoryAction {
  CREATED
  ASSIGNED
  STARTED
  COMPLETED
  REOPENED
}

model User {
  id       String   @id @default(uuid())
  name     String
  email    String   @unique
  password String
  role     UserRole @default(TECHNICIAN)

  callsAssigned Call[] @relation("AssignedTechnician")
  callsOpened   Call[] @relation("OpenedBy")

  workLogs    WorkLog[]
  hourBatches HourBatch[]
  history     CallHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sector {
  id             String @id @default(uuid())
  name           String @unique
  normalizedName String @unique

  calls Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id             String @id @default(uuid())
  name           String @unique
  normalizedName String @unique

  calls Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Call {
  id          String  @id @default(uuid())
  title       String
  description String?

  status   CallStatus   @default(OPEN)
  priority CallPriority @default(MEDIUM)

  sectorId String
  sector   Sector @relation(fields: [sectorId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  openedById String
  openedBy   User   @relation("OpenedBy", fields: [openedById], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedTechnician", fields: [assignedToId], references: [id])

  report Report?

  workLogs WorkLog[]
  history  CallHistory[]

  openedAt   DateTime  @default(now())
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Report {
  id String @id @default(uuid())

  serviceDone String

  partChanged Boolean @default(false)

  partName String?

  observations String?

  callId String @unique
  call   Call   @relation(fields: [callId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkLog {
  id String @id @default(uuid())

  startTime DateTime
  endTime   DateTime

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  callId String
  call   Call   @relation(fields: [callId], references: [id])

  batchId String?
  batch   HourBatch? @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HourBatch {
  id String @id @default(uuid())

  technicianId String
  technician   User   @relation(fields: [technicianId], references: [id])

  workLogs WorkLog[]

  pdfPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CallHistory {
  id String @id @default(uuid())

  action CallHistoryAction

  observation String?

  callId String
  call   Call   @relation(fields: [callId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
